  animation: flash 0.5s infinite;
}

</style>

</head>

<body class=")rawliteral";

  html += alarm ? "flashBackground" : "";

  html += R"rawliteral(">

<div class="card">

<h1>LoRa Receiver</h1>






<p>CO2: </p>
<div class="value">)rawliteral";

  html += latestSNR;

