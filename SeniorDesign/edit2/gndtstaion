  server.send(200, "text/html", html);
}

// ─────────────────────────────
// Setup
// ─────────────────────────────
void setup() {

  Serial.begin(115200);

  // Start LoRa UART
  LoRaSerial.begin(115200, SERIAL_8N1, LORA_RX, LORA_TX);

  delay(2000);

  Serial.println("Starting RYLR998 Receiver...");

  // Test module
  sendAT("AT");

  // Receiver address
  sendAT("AT+ADDRESS=2");

  // Must match transmitter
  sendAT("AT+NETWORKID=5");

  // Must match transmitter
  sendAT("AT+BAND=915000000");

  // Optional power
  sendAT("AT+CRFOP=22");

  Serial.println("LoRa Ready");

  // Connect WiFi
  WiFi.begin(ssid, password);

  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected!");

  Serial.print("Open website at: ");
  Serial.println(WiFi.localIP());

  // Start web server
  server.on("/", handleRoot);

  server.begin();

  Serial.println("Web server started");
}

// ─────────────────────────────
// Loop
// ─────────────────────────────
void loop() {

  server.handleClient();

  // Check LoRa packets
  if (LoRaSerial.available()) {

    String incoming = LoRaSerial.readString();

    incoming.trim();

    Serial.println("Received:");
    Serial.println(incoming);

    // Example:
    // +RCV=1,5,HELLO,-45,20

    if (incoming.startsWith("+RCV=")) {

      int firstComma  = incoming.indexOf(',');
      int secondComma = incoming.indexOf(',', firstComma + 1);
      int thirdComma  = incoming.indexOf(',', secondComma + 1);
      int fourthComma = incoming.indexOf(',', thirdComma + 1);
      int fifthComma  = incoming.indexOf(',', fourthComma + 1);

      String sender =
          incoming.substring(5, firstComma);

      String payload =
          incoming.substring(secondComma + 1, thirdComma);

      String rssi =
          incoming.substring(thirdComma + 1, fourthComma);

      // Only first SNR argument
      String snr;

      if (fifthComma == -1) {
        snr = incoming.substring(fourthComma + 1);
      } else {
        snr = incoming.substring(fourthComma + 1, fifthComma);
      }

      // Save values for webpage
      latestSender = sender;
      latestPayload = payload;
      latestRSSI = rssi;
      latestSNR = snr;

      // Serial output
      Serial.println("------ PACKET ------");

    
      Serial.print("CO2: ");
      Serial.println(snr);

      Serial.println("--------------------");
    }
  }
}
