#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>

// ─────────────────────────────
// WiFi credentials
// ─────────────────────────────
const char* ssid = "HenIphone";
const char* password = "ilivecarlyshay";

// ─────────────────────────────
// Web server
// ─────────────────────────────
WebServer server(80);

// ─────────────────────────────
// UART for RYLR998
// ─────────────────────────────
HardwareSerial LoRaSerial(1);

// Nano ESP32 pins
#define LORA_RX D2
#define LORA_TX D3

// ─────────────────────────────
// Variables for website
// ─────────────────────────────
String latestPayload = "--";
String latestRSSI = "--";
String latestSNR = "--";
String latestSender = "--";

// ─────────────────────────────
// Send AT command
// ─────────────────────────────
void sendAT(String cmd) {

  LoRaSerial.println(cmd);

  delay(300);

  while (LoRaSerial.available()) {
    Serial.write(LoRaSerial.read());
  }
}

// ─────────────────────────────
// Webpage
// ─────────────────────────────
void handleRoot() {

  // Alarm if SNR > 1500
  bool alarm = latestSNR.toFloat() > 800;

  String html = R"rawliteral(
<!DOCTYPE html>
<html>

<head>

<meta http-equiv="refresh" content="2">

<title>LoRa Receiver</title>

<style>

body {
  color: white;
  font-family: Arial;
  text-align: center;
  padding-top: 40px;
  margin: 0;
}
  
.card {
  background: #1e1e1e;
