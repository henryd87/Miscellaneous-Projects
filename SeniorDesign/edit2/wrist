#include <Arduino.h>
#include <WiFi.h>
#include <esp_wifi.h>
#include <esp_now.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>
#include <SPI.h>

#define TFT_CS   10
#define TFT_DC    8
#define TFT_RST   9
#define TFT_MOSI 11
#define TFT_SCLK 12
#define TFT_MISO 13

// ── LoRa configuration ────────────────────────
#define LORA_RX_PIN    16
#define LORA_TX_PIN    17
#define LORA_ADDRESS   200
#define DEST_ADDRESS   0        // 0 = broadcast to ALL LoRa listeners on network
#define NETWORK_ID     5
#define FREQUENCY_BAND 915000000
HardwareSerial LoRaSerial(1);

// ── Latest LoRa status ────────────────────────
String loraStatus = "--";

Adafruit_ILI9341 tft = Adafruit_ILI9341(TFT_CS, TFT_DC, TFT_RST);

typedef struct {
  float co2;
  float temperature;
  float humidity;
} SensorData;

SensorData receivedData;
volatile bool newDataAvailable = false;

// ── Forward declarations ──────────────────────
void setupLoRa();
void sendATCommand(String command);
void sendViaLoRa(float co2);

void onDataReceived(const esp_now_recv_info_t *recvInfo,
                    const uint8_t *data,
                    int dataLen)
{
  if (dataLen != sizeof(SensorData)) return;
  memcpy(&receivedData, data, sizeof(SensorData));
  newDataAvailable = true;
}

void drawScreen(float co2) {
  // Clear old value area only (avoids full screen flicker)
  tft.fillRect(0, 60, 320, 80, ILI9341_BLACK);

  // CO2 label
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.print("CO2 Level:");

  // CO2 value — big text
  tft.setTextSize(5);
  tft.setCursor(10, 70);
  if (co2 > 1200) {
    tft.setTextColor(ILI9341_RED);
  } else {
    tft.setTextColor(ILI9341_GREEN);
  }
  tft.printf("%.0f", co2);

  // ppm label
  tft.setTextSize(2);
  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(10, 150);
  tft.print("ppm");

  // Warning banner
  if (co2 > 1200) {
    tft.fillRect(0, 180, 320, 60, ILI9341_RED);
    tft.setTextColor(ILI9341_WHITE);
    tft.setTextSize(2);
    tft.setCursor(40, 205);
    tft.print("WARNING: CO2 HIGH!");
  } else {
    tft.fillRect(0, 180, 320, 60, ILI9341_BLACK);
    tft.setTextColor(ILI9341_GREEN);
    tft.setTextSize(2);
    tft.setCursor(40, 205);
    tft.print("CO2 Level Safe");
  }

  // ── LoRa status row at bottom ─────────────
  tft.fillRect(0, 250, 320, 30, ILI9341_BLACK);
  tft.setTextSize(2);
  tft.setCursor(10, 255);
  if (loraStatus.indexOf("+OK") != -1) {
    tft.setTextColor(ILI9341_GREEN);
    tft.print("LoRa: +OK");
  } else if (loraStatus.indexOf("+READY") != -1) {
    tft.setTextColor(ILI9341_CYAN);
    tft.print("LoRa: +READY");
  } else if (loraStatus.length() > 0) {
    tft.setTextColor(ILI9341_RED);
    tft.print("LoRa: " + loraStatus);
  } else {
    tft.setTextColor(ILI9341_WHITE);
    tft.print("LoRa: --");
  }
}

// ── AT command helper ─────────────────────────
void sendATCommand(String command) {
  while (LoRaSerial.available()) LoRaSerial.read(); // flush

  LoRaSerial.println(command);
  Serial.println("CMD: " + command);
  delay(100);

  String response = "";
  unsigned long startTime = millis();
  while (millis() - startTime < 2000) {
    if (LoRaSerial.available()) {
      response += LoRaSerial.readString();
    }
  }

  if (response.length() > 0) {
    Serial.println("  -> " + response);
  }
}

// ── LoRa setup ────────────────────────────────
void setupLoRa() {
  LoRaSerial.begin(115200, SERIAL_8N1, LORA_RX_PIN, LORA_TX_PIN);
  delay(500);
  sendATCommand("AT");
  sendATCommand("AT+ADDRESS=" + String(LORA_ADDRESS));
  sendATCommand("AT+NETWORKID=" + String(NETWORK_ID));
  sendATCommand("AT+BAND=" + String(FREQUENCY_BAND));
  sendATCommand("AT+CRFOP=22");
  sendATCommand("AT+PARAMETER?");
  Serial.println("LoRa ready — broadcasting to all listeners");
}

// ── Send CO2 via LoRa to all listeners ────────
// Payload format: lat,lon,co2 (lat/lon = 0, no GPS on this node)
void sendViaLoRa(float co2) {
  String payload = "0.000000,0.000000," + String(co2, 1);
  String cmd = "AT+SEND=" + String(DEST_ADDRESS) + "," +
               String(payload.length()) + "," + payload;

  LoRaSerial.println(cmd);
  Serial.println("LoRa TX: " + cmd);

  delay(100);
  String response = "";
  unsigned long start = millis();
  while (millis() - start < 1000) {
    if (LoRaSerial.available()) response += LoRaSerial.readString();
  }

  response.trim();
  if (response.length() > 0) {
    loraStatus = response;
    Serial.println("LoRa response: " + response);
  }
}

void setup() {
  Serial.begin(115200);
  delay(500);

  // TFT setup
  tft.begin();
  tft.setRotation(1);
  tft.fillScreen(ILI9341_BLACK);
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.print("Waiting for data...");

  // ESP-NOW setup
  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  WiFi.disconnect();
  delay(100);

  Serial.print("S3 MAC: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed!");
    while (true) delay(10);
  }

  esp_now_register_recv_cb(onDataReceived);
  Serial.println("Ready. Waiting for CO2 data...");

  // LoRa setup
  setupLoRa();
}

void loop() {
  if (newDataAvailable) {
    newDataAvailable = false;

    Serial.printf("CO2: %.1f ppm\n", receivedData.co2);

    // Send CO2 via LoRa to all listeners
    sendViaLoRa(receivedData.co2);

    // Draw screen with updated LoRa status
    drawScreen(receivedData.co2);
  }
  delay(10);
}
